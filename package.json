{
  "name": "dr-quiro-reportes",
  "productName": "DR·QUIRO Reportes",
  "version": "1.0.1",
  "description": "DR·QUIRO Reportes – genera reportes de pacientes en Canva",
  "author": "Brian Pulgarin",
  "license": "UNLICENSED",
  "private": true,
  "main": "dist/main/main.js",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "npm run typecheck && vite build && node scripts/build-main.mjs",
    "build:fast": "vite build && node scripts/build-main.mjs",
    "start": "electron .",
    "start:mock": "cross-env DRQUIRO_MOCK_CANVA=1 electron .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "model": "node scripts/download-model.mjs",
    "contact-sheet": "tsx scripts/contact-sheet.ts",
    "screenshots": "node scripts/screenshots.mjs",
    "dist:win": "npm run build && electron-builder --win --x64 --publish never",
    "dist:mac": "npm run build && electron-builder --mac --x64 --arm64--publish never",
    "dist:linux": "npm run build && electron-builder --linux dir",
    "icon": "node scripts/make-icon.mjs"
  },
  "dependencies": {
    "onnxruntime-node": "1.31.1",
    "onnxruntime-node-darwin-x64": "npm:onnxruntime-node@1.23.2",
    "sharp": "0.35.5"
  },
  "devDependencies": {
    "@dnd-kit/core": "6.3.1",
    "@dnd-kit/sortable": "10.0.0",
    "@dnd-kit/utilities": "3.2.2",
    "@fontsource/montserrat": "5.3.0",
    "@modelcontextprotocol/sdk": "1.32.2",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "cross-env": "10.1.0",
    "electron": "45.1.0",
    "electron-builder": "26.18.0",
    "esbuild": "0.28.2",
    "lucide-react": "1.64.0",
    "playwright": "1.64.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tsx": "^4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "4.1.12",
    "zod": "4.6.7"
  }
}
